# BREAKPOINT Environment Configuration

# LLM Provider (OpenAI compatible)
OPENAI_API_KEY=your_key_here
OPENAI_BASE_URL=          # Optional: set for Azure, local, or other providers
BREAKPOINT_MODEL=gpt-4o-mini  # Or gpt-4o, claude-3-5-sonnet, etc.

# Logging
LOG_LEVEL=INFO  # DEBUG for verbose output

# Agent limits
MAX_STEPS=40
MAX_RUNTIME_SECONDS=300
